  <bpmn2:error id="Error_1" name="ProcessError" errorCode="P1" />
  <bpmn2:process id="Process" isExecutable="true">
    <bpmn2:startEvent id="StartEvent_1">
      <bpmn2:outgoing>Flow_start</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="Flow_start" sourceRef="StartEvent_1" targetRef="Gateway_Split" />
    <bpmn2:parallelGateway id="Gateway_Split">
      <bpmn2:incoming>Flow_start</bpmn2:incoming>
      <bpmn2:outgoing>Flow_a</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_b</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:sequenceFlow id="Flow_a" sourceRef="Gateway_Split" targetRef="Activity_1" />
    <bpmn2:sequenceFlow id="Flow_b" sourceRef="Gateway_Split" targetRef="Activity_2" />
    <bpmn2:task id="Activity_1">
      <bpmn2:incoming>Flow_a</bpmn2:incoming>
      <bpmn2:outgoing>Flow_a2</bpmn2:outgoing>
      <bpmn2:standardLoopCharacteristics />
    </bpmn2:task>
    <bpmn2:task id="Activity_2">
      <bpmn2:incoming>Flow_b</bpmn2:incoming>
      <bpmn2:outgoing>Flow_b2</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
    </bpmn2:task>
    <bpmn2:sequenceFlow id="Flow_a2" sourceRef="Activity_1" targetRef="Gateway_Join" />
    <bpmn2:sequenceFlow id="Flow_b2" sourceRef="Activity_2" targetRef="Gateway_Join" />
    <bpmn2:parallelGateway id="Gateway_Join">
      <bpmn2:incoming>Flow_a2</bpmn2:incoming>
      <bpmn2:incoming>Flow_b2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_end</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:sequenceFlow id="Flow_end" sourceRef="Gateway_Join" targetRef="EndEvent_1" />
    <bpmn2:endEvent id="EndEvent_1">
      <bpmn2:incoming>Flow_end</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:boundaryEvent id="BoundaryEvent_1" attachedToRef="Activity_1">
      <bpmn2:outgoing>Flow_be</bpmn2:outgoing>
      <bpmn2:errorEventDefinition id="ErrorDef_1" />
    </bpmn2:boundaryEvent>
    <bpmn2:sequenceFlow id="Flow_be" sourceRef="BoundaryEvent_1" targetRef="EndEvent_Boundary" />
    <bpmn2:endEvent id="EndEvent_Boundary">
      <bpmn2:incoming>Flow_be</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:subProcess id="EventSub_1" triggeredByEvent="true">
      <bpmn2:startEvent id="EvtStart_1" isInterrupting="false">
        <bpmn2:outgoing>Flow_t1</bpmn2:outgoing>
        <bpmn2:timerEventDefinition id="TimerDef_1" />
      </bpmn2:startEvent>
      <bpmn2:sequenceFlow id="Flow_t1" sourceRef="EvtStart_1" targetRef="Task_T1" />
      <bpmn2:task id="Task_T1" name="Wait">
        <bpmn2:incoming>Flow_t1</bpmn2:incoming>
        <bpmn2:outgoing>Flow_t2</bpmn2:outgoing>
      </bpmn2:task>
      <bpmn2:sequenceFlow id="Flow_t2" sourceRef="Task_T1" targetRef="ErrEnd_1" />
      <bpmn2:endEvent id="ErrEnd_1" name="throw error">
        <bpmn2:incoming>Flow_t2</bpmn2:incoming>
        <bpmn2:errorEventDefinition id="ErrDef_throw" errorRef="Error_1" />
      </bpmn2:endEvent>
    </bpmn2:subProcess>
    <bpmn2:subProcess id="EventSub_2" triggeredByEvent="true">
      <bpmn2:startEvent id="ErrStart_2">
        <bpmn2:outgoing>Flow_e1</bpmn2:outgoing>
        <bpmn2:errorEventDefinition id="ErrDef_catch" errorRef="Error_1" />
      </bpmn2:startEvent>
      <bpmn2:sequenceFlow id="Flow_e1" sourceRef="ErrStart_2" targetRef="Task_T2" />
      <bpmn2:task id="Task_T2" name="Handle error">
        <bpmn2:incoming>Flow_e1</bpmn2:incoming>
        <bpmn2:outgoing>Flow_e2</bpmn2:outgoing>
      </bpmn2:task>
      <bpmn2:sequenceFlow id="Flow_e2" sourceRef="Task_T2" targetRef="End_2" />
      <bpmn2:endEvent id="End_2">
        <bpmn2:incoming>Flow_e2</bpmn2:incoming>
      </bpmn2:endEvent>
    </bpmn2:subProcess>
  </bpmn2:process>
