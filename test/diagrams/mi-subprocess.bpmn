<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="mi-subprocess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn2:process id="Process_1" isExecutable="true">
    <bpmn2:startEvent id="StartEvent_1">
      <bpmn2:outgoing>Flow_in</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="Flow_in" sourceRef="StartEvent_1" targetRef="MISub_1" />
    <bpmn2:subProcess id="MISub_1" name="MI sub-process">
      <bpmn2:incoming>Flow_in</bpmn2:incoming>
      <bpmn2:outgoing>Flow_out</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics />
      <bpmn2:startEvent id="Inner_start">
        <bpmn2:outgoing>Flow_a</bpmn2:outgoing>
      </bpmn2:startEvent>
      <bpmn2:sequenceFlow id="Flow_a" sourceRef="Inner_start" targetRef="Inner_task" />
      <bpmn2:task id="Inner_task">
        <bpmn2:incoming>Flow_a</bpmn2:incoming>
        <bpmn2:outgoing>Flow_b</bpmn2:outgoing>
      </bpmn2:task>
      <bpmn2:sequenceFlow id="Flow_b" sourceRef="Inner_task" targetRef="Inner_end" />
      <bpmn2:endEvent id="Inner_end">
        <bpmn2:incoming>Flow_b</bpmn2:incoming>
      </bpmn2:endEvent>
    </bpmn2:subProcess>
    <bpmn2:sequenceFlow id="Flow_out" sourceRef="MISub_1" targetRef="EndEvent_1" />
    <bpmn2:endEvent id="EndEvent_1">
      <bpmn2:incoming>Flow_out</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MISub_1_di" bpmnElement="MISub_1" isExpanded="true">
        <dc:Bounds x="250" y="80" width="400" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inner_start_di" bpmnElement="Inner_start">
        <dc:Bounds x="290" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inner_task_di" bpmnElement="Inner_task">
        <dc:Bounds x="370" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inner_end_di" bpmnElement="Inner_end">
        <dc:Bounds x="520" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="710" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_in_di" bpmnElement="Flow_in">
        <di:waypoint x="196" y="180" />
        <di:waypoint x="250" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_a_di" bpmnElement="Flow_a">
        <di:waypoint x="326" y="180" />
        <di:waypoint x="370" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_b_di" bpmnElement="Flow_b">
        <di:waypoint x="470" y="180" />
        <di:waypoint x="520" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_out_di" bpmnElement="Flow_out">
        <di:waypoint x="650" y="180" />
        <di:waypoint x="710" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
