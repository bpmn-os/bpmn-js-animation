<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>StartEvent_1-Task_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_1" name="Task 1">
      <bpmn:incoming>StartEvent_1-Task_1</bpmn:incoming>
      <bpmn:outgoing>Task_1-Gateway_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_1">
      <bpmn:incoming>Task_1-Gateway_1</bpmn:incoming>
      <bpmn:outgoing>Gateway_1-Task_2</bpmn:outgoing>
      <bpmn:outgoing>Gateway_1-Task_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="Task_2" name="Task 2">
      <bpmn:incoming>Gateway_1-Task_2</bpmn:incoming>
      <bpmn:outgoing>Task_2-EndEvent_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_3" name="Task 3">
      <bpmn:incoming>Gateway_1-Task_3</bpmn:incoming>
      <bpmn:outgoing>Task_3-EndEvent_2</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>Task_2-EndEvent_1</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDefinition_1" />
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_2">
      <bpmn:incoming>Task_3-EndEvent_2</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="StartEvent_1-Task_1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Task_1-Gateway_1" sourceRef="Task_1" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Gateway_1-Task_2" sourceRef="Gateway_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Gateway_1-Task_3" sourceRef="Gateway_1" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Task_2-EndEvent_1" sourceRef="Task_2" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Task_3-EndEvent_2" sourceRef="Task_3" targetRef="EndEvent_2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="240" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1">
        <dc:Bounds x="395" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="500" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="500" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="662" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_2_di" bpmnElement="EndEvent_2">
        <dc:Bounds x="662" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="StartEvent_1-Task_1_di" bpmnElement="StartEvent_1-Task_1">
        <di:waypoint x="188" y="240" />
        <di:waypoint x="240" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Task_1-Gateway_1_di" bpmnElement="Task_1-Gateway_1">
        <di:waypoint x="340" y="240" />
        <di:waypoint x="395" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Gateway_1-Task_2_di" bpmnElement="Gateway_1-Task_2">
        <di:waypoint x="420" y="215" />
        <di:waypoint x="420" y="160" />
        <di:waypoint x="500" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Gateway_1-Task_3_di" bpmnElement="Gateway_1-Task_3">
        <di:waypoint x="420" y="265" />
        <di:waypoint x="420" y="340" />
        <di:waypoint x="500" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Task_2-EndEvent_1_di" bpmnElement="Task_2-EndEvent_1">
        <di:waypoint x="600" y="160" />
        <di:waypoint x="662" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Task_3-EndEvent_2_di" bpmnElement="Task_3-EndEvent_2">
        <di:waypoint x="600" y="340" />
        <di:waypoint x="662" y="340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
